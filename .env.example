# Razorpay Test Mode API Keys
# Get from: https://dashboard.razorpay.com → Settings → API Keys → Generate (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Groq API Key (free)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Optional: Change model
GROQ_MODEL=openai/gpt-oss-20b

# ElevenLabs Conversational AI (voice mode)
# Get from: https://elevenlabs.io/app/conversational-ai
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
